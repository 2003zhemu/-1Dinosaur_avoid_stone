{
    "name": "wdm.config-provider",
    "version": "0.6.2",
    "description": "",
    "main": "index.js",
    "author": "",
    "bin": {
        "config_build": "config_build.bat",
        "config_watch": "config_watch.bat"
    },
    "file-sync-overwrite": {
        "configs\\_ConfigManagerCore": "configs\\_ConfigManagerCore"
    },
    "scripts": {
        "rojo": "rojo serve dev.project.json",
        "postuninstall": "del-cli ../../Packages/wdm.config-provider --force",
        "postinstall": "npm run postuninstall && lnk ../wdm.config-provider ../../Packages ",
        "config:build": "luban -t all --conf .\\configs\\luban.conf -d json -d lua  -x lua.outputDataDir=_genConfigs -x json.outputDataDir=_genConfigsJson",
        "config:watch": "npm run config:build -- -w .\\configs"
    },
    "license": "ISC",
    "dependencies": {
        "app-root-path": "^3.1.0",
        "wdm.luban-next": "^3.7.1",
        "wdm.rewire": "^0.3.2",
        "wdm.rojo": "^1.0.3"
    }
}