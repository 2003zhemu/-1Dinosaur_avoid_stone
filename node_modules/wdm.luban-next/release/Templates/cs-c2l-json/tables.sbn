

using System.Collections.Generic;

#if !__CSharpLua__
using System.Text.Json;
#endif

{{namespace_with_grace_begin __namespace}}
   
public partial class {{__name}}
{

    {{~for table in __tables ~}}
{{~if table.comment != '' ~}}
    /// <summary>
    /// {{escape_comment table.comment}}
    /// </summary>
{{~end~}}
    public {{table.full_name}} {{format_property_name __code_style table.name}} {get; }
    {{~end~}}

    public {{__name}}(object serviceContainerLua = null)
    {
        var tables = new System.Collections.Generic.Dictionary<string, object>();
        dynamic initor = null;

        {{~for table in __tables ~}}
        /*
        [[
        if serviceContainerLua then
            initor = serviceContainerLua.Resolve("{{table.namespace}}_{{table.name}}")
        else
            initor = require(game:GetService("ReplicatedStorage")._genConfigs.{{get_lower_file_name table}}:Clone())
        end
        ]]
        */
        this.{{table.name}} = new {{table.full_name}}(initor); 
        tables.Add("{{table.full_name}}",this.{{table.name}});
        {{~end~}}
      
      
        // resolve
        {{~for table in __tables ~}}
        {{table.name}}.Resolve(tables); 
        {{~end~}}

        // after resolve
        {{~for table in __tables ~}}
        {{table.name}}.AfterResolve(this); 
        {{~end~}}
    }
    

#if !__CSharpLua__


        public {{__name}}(System.Func<string, JsonElement> loader)
    {
        var tables = new System.Collections.Generic.Dictionary<string, object>();
        {{~for table in __tables ~}}
        {{format_property_name __code_style table.name}} = new {{table.full_name}}(loader("{{table.output_data_file}}")); 
        tables.Add("{{table.full_name}}", {{table.name}});
        {{~end~}}


        // resolve
        {{~for table in __tables ~}}
        {{table.name}}.Resolve(tables); 
        {{~end~}}

        // after resolve
        {{~for table in __tables ~}}
        {{table.name}}.AfterResolve(this); 
        {{~end~}}
    }
#endif



 
}

{{namespace_with_grace_end __namespace}}


