title: {{if __bean.alias != '' }}{{__bean.alias}}{{~else~}}{{__bean.full_name}}{{~end~}}

---

{{~

func generate_alias_or_full_name
    bean = $0
    result = ''
    if bean.alias != '' 
        result = bean.alias
    else
        result = bean.full_name
    end
    ret result
end

func generate_md_path
    bean = $0
    ret bean.namespace + '/' + bean.name
end

func generate_md_link
    bean = $0
    ret '['+(generate_alias_or_full_name bean)+']'+'(/'+bean.namespace + '/' + bean.name+')'
end

~}}




