using System;
using System.Collections.Generic;

#if !__CSharpLua__
using System.Text.Json;
#endif
{{
    parent_def_type = __bean.parent_def_type
    export_fields = __bean.export_fields
    hierarchy_export_fields = __bean.hierarchy_export_fields
}}


{{namespace_with_grace_begin __namespace_with_top_module}}


{{~if __bean.comment != '' ~}}
/// <summary>
/// {{escape_comment __bean.comment}}
/// </summary>
{{~end~}}
{{~
func get_ref_name 
    ret (format_property_name __code_style $0.name) + '_Ref'
end

func get_index_var_name
    ret (format_property_name __code_style $0.name) + '_Index'
end

func generate_lua_field
    field = $0
    line1 = deserialize_field (format_property_name __code_style field.name) '_json' 'dy["'+field.name+'"]' field.ctype true
    ret "                "+line1 
end

func generate_after_resolve_field
    field = $0
    fieldName = format_property_name __code_style field.name
    if (is_field_bean_need_resolve_ref field)
        ret fieldName + '?.AfterResolve(_tables);'
    else if (is_field_array_like_need_resolve_ref field)
        ret 'foreach(var _e in ' + fieldName + ') { _e?.AfterResolve(_tables); }'
    else if (is_field_map_need_resolve_ref field)
        ret 'foreach(var _e in ' + fieldName + '.Values) { _e?.AfterResolve(_tables); }'
    else
        ret ''
    end
end

func generate_resolve_field_ref
    field = $0
    fieldName = format_property_name __code_style field.name
    refTable = get_ref_table field
    if can_generate_ref field 
        tableName = format_property_name __code_style refTable.full_name
        if field.is_nullable
            ret 'this.'+ (get_ref_name field) + ' = ' + fieldName + '!= null ? tables.' + tableName + '.GetOrDefault(' + (get_value_of_nullable_type field.ctype fieldName) + ') : null;'
        else
            ret 'this.'+ (get_ref_name field) + ' = (_tables["' + tableName + '"] as '+ tableName +').GetOrDefault(' + fieldName + ');'
        end
    else if can_generate_collection_ref field 
        collection_ref_table = get_collection_ref_table field
        tableName = format_property_name __code_style collection_ref_table.name
        tableFullName = format_property_name __code_style collection_ref_table.full_name
        refTtypeName = tableFullName
		if field.ctype.type_name == 'list' || field.ctype.type_name == 'set'
        
            line1 = '{ '+refTtypeName+' __table = ('+refTtypeName+')_tables["'+refTtypeName+'"]; '
            line2 = 'this.'+ (get_ref_name field) + ' = new ' + (declaring_collection_ref_name field.ctype) + '(); '  
            line3 = 'foreach(var __e in ' + fieldName + ') { this.' + (get_ref_name field) + '.Add(__table.GetOrDefault(__e)); } }' 
            ret line1 + line2+ line3
        else if field.ctype.type_name == 'array'
        
            line6 = (get_ref_name field) + ' = new ' + (declaring_type_name collection_ref_table.value_ttype) + '[' + fieldName + '.Length];' + '\n'
            line7 = 'for (int _i = 0; _i < ' + fieldName + '.Length; _i++) { ' + (get_ref_name field) + '[_i] = tables.' + tableName + '.GetOrDefault(' + fieldName + '[_i]); }' + '\n'
            
            line1 = '{ int __n = ' + fieldName + '.Length; '+refTtypeName+' __table = ('+refTtypeName+')_tables["'+refTtypeName+'"]; '
            line2 = 'this.'+ (get_ref_name field) + ' = new ' + declaring_type_name collection_ref_table.value_ttype + '[__n]; '  
            line3 = 'for(int i = 0 ; i < __n ; i++) { this.' + (get_ref_name field) + '[i] =  __table.GetOrDefault(PropertyIds[i]); } }' 
            ret line1 + line2+ line3
		else if field.ctype.type_name == 'map'
        
            line1 = (get_ref_name field) + ' = new ' + (declaring_collection_ref_name field.ctype) + '();' + '\n'
			line2 = 'foreach(var kvp in ' + fieldName + ') { ' + (get_ref_name field) + '.Add(kvp.Key, tables.' + tableName + '.GetOrDefault(kvp.Value)); }' + '\n'
			ret line1 + line2
		else
			ret ''
		end
    else
        if (is_field_bean_need_resolve_ref field)
            ret fieldName + '?.Resolve(_tables);'
        else if (is_field_array_like_need_resolve_ref field)
            ret 'foreach(var _e in ' + fieldName + ') { _e?.Resolve(_tables); }'
        else if (is_field_map_need_resolve_ref field)
            ret 'foreach(var _e in ' + fieldName + '.Values) { _e?.Resolve(_tables); }'
        else
            ret ''
        end
    end
end
~}}
{{~if __bean.is_value_type~}}
public partial struct {{__name}}
{{~else~}}
public {{class_modifier __bean}} partial class {{__name}} :  {{if parent_def_type}}{{__bean.parent}}{{else}} wdm.WuKong.Configs.BeanBase{{end}}  
{{~end~}}
{

    public {{__name}}() 
    {

    }
#if __CSharpLua__

      public {{__name}}(object data) {{if parent_def_type}} : base(data) {{end}}
    {
        this.Operator = "";
        this.OriginConfig = data;
        var dy = (dynamic)data;
            /*
             [[
          dy.get=function(this,id)
            return this[id]
          end
                ]]
             */

        {{~ for field in export_fields ~}}

            if (LuaTable.GetObject(dy,"{{field.name}}") != null)
            {
{{~ line = generate_lua_field field ~}}
{{~ if line != ''~}}
{{line}}
{{~end~}}
            }
            {{~if field.index_field~}}
            foreach(var _v in {{field.convention_name}}) { {{field.convention_name}}_Index.Add(_v.{{field.index_field.convention_name}}, _v); }
            {{~end~}}
        {{~end~}}

     
        this.SelfCheck();
    }


    public static {{__name}} Deserialize{{__name}}(dynamic data)
    {
    var obj = (object)data;
            /*
             [[
          data.get=function(this,id)
            return this[id]
          end
                ]]
             */
    {{~if __bean.is_abstract_type~}}
        switch (data["_type_"])
        {
        {{~for child in __bean.hierarchy_not_abstract_children~}}
            case "{{impl_data_type child __bean}}": return new {{child.full_name}}(obj);
        {{~end~}}
        }
        
        string subName = data["_type_"];
        var typeName = "{{__top_module}}." + subName;
        var t = Type.GetType(typeName);
        if (t == null)
        {
            throw new SerializationException("无法反序列化:" + typeName);
        }
        {{__name}} result = null;
        /*
        [[
            result = System.new(t[1], 2, obj)
       ]]
        */
        return result;
    {{~else~}}
        return new {{__bean.full_name}}(obj);
    {{~end~}}
    }

#else 

    public {{__name}}(object obj) {{if parent_def_type}} : base(obj) {{end}}
    {
        var _json = (JsonElement)obj;

        {{~ for field in export_fields
            fieldName = format_property_name __code_style field.name
         ~}}
        {{deserialize_field fieldName '_json' field.name field.ctype}}
            {{~if has_index field~}}

        foreach(var _v in {{fieldName}})
        { 
            {{get_index_var_name field}}.Add(_v.{{format_property_name __code_style (get_index_field field).name}}, _v);
        }
            {{~end~}}
        {{~end~}}
        this.Operator = "";
        this.OriginConfig = _json;
        this.SelfCheck();
    }

    public static {{__name}} Deserialize{{__name}}(object obj)
    {
        var _json = (JsonElement)obj;
    {{~if __bean.is_abstract_type~}}
        switch (_json.GetProperty("$type").GetString())
        {
        {{~for child in __bean.hierarchy_not_abstract_children~}}
            case "{{impl_data_type child __bean}}": return new {{child.full_name}}(_json);
        {{~end~}}
            default: break;
            }
    
        var typeName = "{{__top_module}}." + _json.GetProperty("$type").GetString();

        var t = PluginAssembliesLoader.GetType(typeName);
        if (t == null)
        {
            throw new SerializationException("无法反序列化:"+typeName);
        }
        return ({{__name}})Activator.CreateInstance(t,_json);    
    {{~else~}}
        return new {{__bean.full_name}}(_json);
    {{~end~}}
    }


#endif
 
    public override string Alias {get;set;} =  "{{__bean.alias}}" ;

{{~ for field in export_fields ~}}
{{~if field.comment != '' ~}}
    /// <summary>
    /// {{escape_comment field.comment}}
    /// </summary>
{{~end~}}
    public {{declaring_type_name field.ctype}} {{format_property_name __code_style field.name}};
    {{~if can_generate_ref field~}}
    public {{declaring_type_name (get_ref_type field)}} {{get_ref_name field}} { get; private set; }
    {{~else if can_generate_collection_ref field~}}
    public {{declaring_collection_ref_name field.ctype}} {{get_ref_name field}} { get; private set; }
    {{~end~}}
   {{~if has_index field
        indexMapType = get_index_map_type field
   ~}}
    public {{declaring_type_name indexMapType}} {{get_index_var_name field}} = new {{declaring_type_name indexMapType}}();
   {{~end~}}
   {{~end~}}

{{~if !__bean.is_abstract_type && !__bean.is_value_type~}}
    public const int __ID__ = {{__bean.id}};
    public override int GetTypeId() => __ID__;
{{~end~}}

    public {{method_modifier __bean}} void Resolve(Dictionary<string, object> _tables)
    {
        {{~if parent_def_type~}}
        base.Resolve(_tables);
        {{~end~}}
        {{~for field in export_fields~}}
            {{~ line = generate_resolve_field_ref field~}}
                {{~ if line != ''~}}
        {{line}}
                {{~end~}}
        {{~end~}}
    {{~if !__bean.is_abstract_type~}}
        this.InitOperator();
    {{~end~}}

    }

    public {{method_modifier __bean}} void AfterResolve(Tables _tables)
    {
        {{~if parent_def_type~}}
        base.AfterResolve(_tables);
        {{~end~}}
        {{~for field in export_fields~}}
            {{~ line = generate_after_resolve_field field~}}
                {{~ if line != ''~}}
        {{line}}
                {{~end~}}
        {{~end~}}
    }

    public override string ToString()
    {
        return "";
    }

}
{{namespace_with_grace_end __namespace_with_top_module}}

