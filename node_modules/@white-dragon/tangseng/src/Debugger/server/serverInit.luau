local start = require(script.Parent.Parent.shared.start)
local PluginsManager = require(script.Parent.Parent.shared.PluginsManager)

return function(
	components,
	services: IServiceProvider,
	playerScopeProvider: (userIdOrPlayer: number | Player) -> IServiceScope
)
	local debugger = start({
		script.Parent.systems,
		unpack(PluginsManager.GetSystems()),
	}, components, services, playerScopeProvider)
	return debugger
end
