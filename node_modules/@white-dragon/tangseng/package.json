{
  "name": "@white-dragon/tangseng",
  "version": "0.3.12",
  "description": "",
  "main": "index.js",
  "workspaces": [
    "../CoreServices/src/*",
    "../CoreServices/src_community/*",
    "../CoreServices/src_utils/*"
  ],
  "scripts": {
    "release": "npm publish",
    "dev": "npx commands-runner",
    "rojo": "rojo serve",
    "doc:dev": "moonwave dev",
    "tangseng:gen": "node scripts/index.js default.rojo-template.project.json default.project.json  roblox-instances/Systems src node_modules/@white-dragon",
    "prepack": "copy pack.default.project.json default.project.json",
    "doc:build": "moonwave build --out-dir build_doc"
  },
  "bin": {
    "tangseng": "scripts/index.js",
    "tangseng-configs": "scripts/index.configs.js"
  },
  "file-sync-overwrite": {
    "": "Packages/TangSeng"
  },
  "files": [
    "src/**/*",
    "scripts/**/*",
    "default.project.json"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@white-dragon/debug-options": "^0.1.0",
    "@white-dragon/dotenv": "^0.6.0",
    "@white-dragon/eventbus": "^0.3.0",
    "@white-dragon/log-manager": "^0.2.0",
    "@white-dragon/matter-ecs": "^0.8.4",
    "@white-dragon/rewire": "^0.3.7",
    "chokidar": "^4.0.1",
    "fs-extra": "^11.2.0",
    "app-root-path": "^3.1.0"
  },
  "devDependencies": {
    "@white-dragon/testez": "^0.4.2",
    "@white-dragon-utils/commands-runner": "^0.1.0",
    "@white-dragon-utils/rojo": "^7.4.4"
  }
}